{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design system de fixture pour l'IR v0.1. Tous les tokens référencés par examples/Login.ir sont définis ici. Les primitives (palette) ne sont pas référençables depuis l'IR.",

  "space": {
    "$type": "dimension",
    "none": { "$value": { "value": 0,  "unit": "px" } },
    "xs":   { "$value": { "value": 4,  "unit": "px" } },
    "sm":   { "$value": { "value": 8,  "unit": "px" } },
    "md":   { "$value": { "value": 16, "unit": "px" } },
    "lg":   { "$value": { "value": 24, "unit": "px" } },
    "xl":   { "$value": { "value": 32, "unit": "px" } }
  },

  "size": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "icon": {
      "sm": { "$value": { "value": 16, "unit": "px" } },
      "md": { "$value": { "value": 24, "unit": "px" } },
      "lg": { "$value": { "value": 32, "unit": "px" } }
    }
  },

  "radius": {
    "$type": "dimension",
    "sm":   { "$value": { "value": 4,   "unit": "px" } },
    "md":   { "$value": { "value": 8,   "unit": "px" } },
    "lg":   { "$value": { "value": 16,  "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },

  "bp": {
    "$type": "dimension",
    "$description": "Breakpoints. compact est la base (min-width 0), expanded commence à 600.",
    "compact":  { "$value": { "value": 0,   "unit": "px" } },
    "expanded": { "$value": { "value": 600, "unit": "px" } }
  },

  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.4 },
    "muted":    { "$value": 0.7 }
  },

  "color": {
    "$type": "color",

    "palette": {
      "$description": "Primitives. Non référençables depuis l'IR (E002 si tenté).",
      "$extensions": { "ir": { "referenceable": false } },
      "gray": {
        "0":   { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
        "50":  { "$value": { "colorSpace": "srgb", "components": [0.969, 0.969, 0.961], "hex": "#F7F7F5" } },
        "100": { "$value": { "colorSpace": "srgb", "components": [0.929, 0.925, 0.910], "hex": "#EDECE8" } },
        "300": { "$value": { "colorSpace": "srgb", "components": [0.788, 0.780, 0.753], "hex": "#C9C7C0" } },
        "500": { "$value": { "colorSpace": "srgb", "components": [0.478, 0.475, 0.459], "hex": "#7A7975" } },
        "700": { "$value": { "colorSpace": "srgb", "components": [0.267, 0.267, 0.247], "hex": "#44443F" } },
        "900": { "$value": { "colorSpace": "srgb", "components": [0.110, 0.110, 0.102], "hex": "#1C1C1A" } }
      },
      "blue": {
        "500": { "$value": { "colorSpace": "srgb", "components": [0.184, 0.435, 0.871], "hex": "#2F6FDE" } },
        "700": { "$value": { "colorSpace": "srgb", "components": [0.118, 0.310, 0.659], "hex": "#1E4FA8" } }
      }
    },

    "bg": {
      "canvas": { "$value": "{color.palette.gray.0}" },
      "field":  { "$value": "{color.palette.gray.50}" }
    },
    "text": {
      "primary":   { "$value": "{color.palette.gray.900}" },
      "secondary": { "$value": "{color.palette.gray.500}" },
      "onAccent":  { "$value": "{color.palette.gray.0}" }
    },
    "accent": { "$value": "{color.palette.blue.500}" },
    "border": {
      "default": { "$value": "{color.palette.gray.300}" }
    }
  },

  "font": {
    "$extensions": { "ir": { "referenceable": false } },
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },

  "type": {
    "$type": "typography",
    "$description": "Tokens composites. L'IR ne référence que ceux-ci pour Text.style.",
    "heading": {
      "lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 28, "unit": "px" }, "lineHeight": 1.214, "fontWeight": "{font.weight.semibold}", "letterSpacing": { "value": -0.4, "unit": "px" } } },
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 22, "unit": "px" }, "lineHeight": 1.273, "fontWeight": "{font.weight.semibold}", "letterSpacing": { "value": -0.2, "unit": "px" } } }
    },
    "body": {
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 16, "unit": "px" }, "lineHeight": 1.5,   "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" } } },
      "sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 14, "unit": "px" }, "lineHeight": 1.429, "fontWeight": "{font.weight.regular}", "letterSpacing": { "value": 0, "unit": "px" } } }
    },
    "label": {
      "md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": { "value": 15, "unit": "px" }, "lineHeight": 1.333, "fontWeight": "{font.weight.medium}", "letterSpacing": { "value": 0.1, "unit": "px" } } }
    }
  },

  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.08, "hex": "#000000" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2,  "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "md": { "$value": { "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12, "hex": "#000000" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
  }
}
